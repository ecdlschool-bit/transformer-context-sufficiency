   "source": [
    "def trusted_torch_load(path, map_location):\n",
    "    # Checkpoints/kernels are self-generated project artifacts.\n",
    "    try:\n",
    "        return torch.load(path, map_location=map_location, weights_only=False)\n",
    "    except TypeError:\n",
    "        return torch.load(path, map_location=map_location)\n",
    "\n",
    "\n",
    "# Exact training configuration used in Part1_Markov_Context_Sufficiency_A100_v2.\n",
    "# We match these fields so stale QUICK_TEST / alternate runs are never selected.\n",
    "EXPECTED_CFG = {\n",
    "    \"main_recovery\": {\n",
    "        \"steps\": 3000,\n",
    "        \"batch_size\": 1024,\n",
    "        \"lr\": 1e-3,\n",
    "        \"weight_decay\": 1e-2,\n",
    "        \"d_model\": 256,\n",
    "        \"n_layers\": 3,\n",
    "        \"n_heads\": 8,\n",
    "        \"dim_ff\": 512,\n",
    "        \"eval_batch\": 4096,\n",
    "        \"save_every\": 500,\n",
    "        \"sparse_s\": None,\n",
    "    },\n",
    "    \"k4_refinement_12k\": {\n",
    "        \"steps\": 12000,\n",
    "        \"batch_size\": 1024,\n",
    "        \"lr\": 1e-3,\n",
    "        \"weight_decay\": 1e-2,\n",
    "        \"d_model\": 256,\n",
    "        \"n_layers\": 3,\n",
    "        \"n_heads\": 8,\n",
    "        \"dim_ff\": 512,\n",
    "        \"eval_batch\": 4096,\n",
    "        \"save_every\": 500,\n",
    "        \"sparse_s\": None,\n",
    "    },\n",
    "}\n",
    "\n",
    "\n",
    "def _cfg_matches_expected(cfg, experiment):\n",
    "    exp = EXPECTED_CFG[experiment]\n",
    "    for key, expected in exp.items():\n",
    "        got = cfg.get(key, None)\n",
    "        if isinstance(expected, float):\n",
    "            try:\n",
    "                if not math.isclose(float(got), expected, rel_tol=1e-12, abs_tol=1e-12):\n",
    "                    return False\n",
    "            except Exception:\n",
    "                return False\n",
    "        else:\n",
    "            if got != expected:\n",
    "                return False\n",
    "    return True\n",
    "\n",
    "\n",
    "def _canonical_run_name(cfg):\n",
    "    # Mirrors the original Part1 RunConfig.run_id() exactly.\n",
    "    import hashlib\n",
    "    s = json.dumps(cfg, sort_keys=True, default=str).encode()\n",
    "    h = hashlib.sha256(s).hexdigest()[:12]\n",
    "    sp = cfg.get(\"sparse_s\") or 0\n",
    "    return (\n",
    "        f\"{cfg['experiment']}_V{cfg['V']}_k{cfg['k']}_L{cfg['L']}_seed{cfg['seed']}\"\n",
    "        f\"_sp{sp}_d{cfg['d_model']}_ly{cfg['n_layers']}_{h}\"\n",
    "    )\n",
    "\n",
    "\n",
    "def discover_run(experiment, V, k, L, seed):\n",
    "    root = RUNS_DIR / experiment\n",
    "    if not root.exists():\n",
    "        raise FileNotFoundError(f\"Experiment directory not found: {root}\")\n",
    "\n",
    "    broad_matches = []\n",
    "    exact_matches = []\n",
    "\n",
    "    for cfg_path in root.glob(\"*/config.json\"):\n",
    "        try:\n",
    "            cfg = json.loads(cfg_path.read_text(encoding=\"utf-8\"))\n",
    "        except Exception:\n",
    "            continue\n",
    "\n",
    "        same_identity = (\n",
    "            int(cfg.get(\"V\", -1)) == int(V)\n",
    "            and int(cfg.get(\"k\", -1)) == int(k)\n",
    "            and int(cfg.get(\"L\", -1)) == int(L)\n",
    "            and int(cfg.get(\"seed\", -1)) == int(seed)\n",
    "            and cfg.get(\"experiment\") == experiment\n",
    "        )\n",
    "        if not same_identity:\n",
    "            continue\n",
    "\n",
    "        broad_matches.append((cfg_path.parent, cfg))\n",
    "        if _cfg_matches_expected(cfg, experiment):\n",
    "            exact_matches.append((cfg_path.parent, cfg))\n",
    "\n",
    "    if not exact_matches:\n",
    "        details = [\n",
    "            {\n",
    "                \"dir\": str(rd),\n",
    "                \"steps\": cfg.get(\"steps\"),\n",
    "                \"batch_size\": cfg.get(\"batch_size\"),\n",
    "                \"d_model\": cfg.get(\"d_model\"),\n",
    "                \"n_layers\": cfg.get(\"n_layers\"),\n",
    "            }\n",
    "            for rd, cfg in broad_matches\n",
    "        ]\n",
    "        raise RuntimeError(\n",
    "            f\"No run matches the ORIGINAL Part1 config for experiment={experiment}, \"\n",
    "            f\"V={V}, k={k}, L={L}, seed={seed}. \"\n",
    "            f\"Identity-matched candidates: {details}\"\n",
    "        )\n",
    "\n",
    "    # Prefer the canonical directory name generated by the original run_id().\n",
    "    canonical = [\n",
    "        (rd, cfg) for rd, cfg in exact_matches\n",
    "        if rd.name == _canonical_run_name(cfg)\n",
    "    ]\n",
    "\n",
    "    candidates = canonical if canonical else exact_matches\n",
    "\n",
    "    # Only accept candidates that contain the immutable source kernel and a checkpoint.\n",
    "    complete = []\n",
    "    for rd, cfg in candidates:\n",
    "        has_kernel = (rd / \"kernel.pt\").exists()\n",
    "        has_ckpt = (rd / \"checkpoint_best.pt\").exists() or (rd / \"checkpoint_last.pt\").exists()\n",
    "        if has_kernel and has_ckpt:\n",
    "            complete.append((rd, cfg))\n",
    "\n",
    "    if len(complete) == 1:\n",
    "        if len(broad_matches) > 1:\n",
    "            print(\n",
    "                f\"[duplicate-safe] {experiment} V={V} k={k} L={L} seed={seed}: \"\n",
    "                f\"{len(broad_matches)} identity matches -> using canonical {complete[0][0].name}\"\n",
    "            )\n",
    "        return complete[0]\n",
    "\n",
    "    raise RuntimeError(\n",
    "        f\"Could not select one canonical complete run for experiment={experiment}, \"\n",
    "        f\"V={V}, k={k}, L={L}, seed={seed}. \"\n",
    "        f\"broad={len(broad_matches)}, exact={len(exact_matches)}, \"\n",
    "        f\"canonical={len(canonical)}, complete={len(complete)}. \"\n",
    "        f\"Candidates={[str(rd) for rd, _ in candidates]}\"\n",
    "    )\n",
    "\n",
    "\n",
    "def choose_checkpoint(run_dir):\n",
    "    best = run_dir / \"checkpoint_best.pt\"\n",
    "    last = run_dir / \"checkpoint_last.pt\"\n",
    "    if best.exists():\n",
    "        return best\n",
    "    if last.exists():\n",
    "        return last\n",
    "    raise FileNotFoundError(f\"No checkpoint found in {run_dir}\")\n",
    "\n",
    "\n",
    "def load_model_and_kernel(experiment, V, k, L, seed):\n",
    "    run_dir, cfg = discover_run(experiment, V, k, L, seed)\n",
    "    ckpt_path = choose_checkpoint(run_dir)\n",
    "    kernel_path = run_dir / \"kernel.pt\"\n",
    "\n",
    "    if not kernel_path.exists():\n",
    "        raise FileNotFoundError(f\"Missing exact saved kernel: {kernel_path}\")\n",
    "\n",
    "    P = trusted_torch_load(kernel_path, map_location=DEVICE)\n",
    "    if isinstance(P, dict):\n",
    "        raise TypeError(f\"Unexpected kernel payload in {kernel_path}\")\n",
    "    P = P.float().to(DEVICE)\n",
    "\n",
    "    ck = trusted_torch_load(ckpt_path, map_location=DEVICE)\n",
    "    state = ck[\"model\"] if isinstance(ck, dict) and \"model\" in ck else ck\n",
    "\n",
    "    max_context = int(state[\"pos_emb.weight\"].shape[0])\n",
    "    d_model = int(cfg.get(\"d_model\", state[\"token_emb.weight\"].shape[1]))\n",
    "    n_layers = int(cfg.get(\"n_layers\", 3))\n",
    "    n_heads = int(cfg.get(\"n_heads\", 8))\n",
    "    dim_ff = int(cfg.get(\"dim_ff\", 512))\n",
    "\n",
    "    model = TinyCausalTransformer(\n",
    "        V=V,\n",
    "        max_context=max_context,\n",
    "        d_model=d_model,\n",
    "        n_layers=n_layers,\n",
    "        n_heads=n_heads,\n",
    "        dim_ff=dim_ff,\n",
    "    ).to(DEVICE)\n",
    "\n",
    "    model.load_state_dict(state, strict=True)\n",
    "    model.eval()\n",
    "\n",
    "    return model, P, cfg, run_dir, ckpt_path\n",
    "\n",
    "\n",
    "inventory = []\n",
    "for k in KS:\n",
    "    exp = EXPERIMENT_BY_K[k]\n",
    "    for L in [k, k + 1]:\n",
    "        for seed in SEEDS:\n",
    "            run_dir, cfg = discover_run(exp, V, k, L, seed)\n",
    "            ckpt = choose_checkpoint(run_dir)\n",
    "            kernel = run_dir / \"kernel.pt\"\n",
    "            inventory.append({\n",
    "                \"experiment\": exp,\n",
    "                \"k\": k,\n",
    "                \"L\": L,\n",
    "                \"seed\": seed,\n",
    "                \"steps\": cfg.get(\"steps\"),\n",
    "                \"run_dir\": str(run_dir),\n",
    "                \"checkpoint\": str(ckpt),\n",
    "                \"kernel_exists\": kernel.exists(),\n",
    "            })\n",
    "\n",
    "inventory_df = pd.DataFrame(inventory)\n",
    "display(inventory_df)\n",
    "assert inventory_df[\"kernel_exists\"].all(), \"At least one kernel.pt is missing.\"\n",
    "assert len(inventory_df) == 30, f\"Expected 30 models, found {len(inventory_df)}.\"\n",
    "print(\"Preflight OK:\", len(inventory_df), \"canonical models ready.\")\n"
   ]
  },
