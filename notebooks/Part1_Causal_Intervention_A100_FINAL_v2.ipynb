    "## Counterfactual construction and metrics\n",
    "\n",
    "For an input \\(x=(x_{t-L+1},\\ldots,x_t)\\):\n",
    "\n",
    "- the true order-\\(k\\) state occupies positions `L-k ... L-1`;\n",
    "- the **critical position** is therefore `L-k`, the oldest token still inside the state;\n",
    "- when \\(L=k+1\\), position `0` is outside the Markov state and is the **irrelevant control**.\n",
    "\n",
    "The replacement token is sampled uniformly from the other \\(V-1\\) symbols, deterministically from the evaluation seed.\n",
    "\n",
    "The oracle distribution is always computed from the exact saved transition kernel, not from sampled labels."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "b83aacf4",
   "metadata": {},
   "outputs": [],
   "source": [
    "def make_alternative_tokens(original, V, generator):\n",
    "    # Uniformly choose one of the V-1 symbols different from original.\n",
    "    r = torch.randint(\n",
    "        low=0, high=V - 1, size=original.shape,\n",
    "        generator=generator, device=original.device\n",
    "    )\n",
    "    return (original + 1 + r) % V\n",
    "\n",
    "\n",
    "def oracle_probs(P, x, V, k):\n",
    "    state = x[:, -k:]\n",
    "    idx = context_to_index(state, V)\n",
    "    return P[idx].float()\n",
    "\n",
    "\n",
    "def kl_pq(p, q, eps=1e-8):\n",
    "    p = p.float().clamp_min(eps)\n",
    "    q = q.float().clamp_min(eps)\n",
    "    return (p * (p.log() - q.log())).sum(dim=-1)\n",
    "\n",
    "\n",
    "def js_divergence(p, q, eps=1e-8):\n",
    "    p = p.float().clamp_min(eps)\n",
    "    q = q.float().clamp_min(eps)\n",
    "    m = 0.5 * (p + q)\n",
    "    return 0.5 * kl_pq(p, m, eps) + 0.5 * kl_pq(q, m, eps)\n",
    "\n",
    "\n",
    "def entropy(p, eps=1e-8):\n",
    "    p = p.float().clamp_min(eps)\n",
    "    return -(p * p.log()).sum(dim=-1)\n",
    "\n",
    "\n",
    "@torch.no_grad()\n",
    "def model_probs(model, x):\n",
    "    with torch.autocast(\n",
    "        device_type=\"cuda\",\n",
    "        dtype=AMP_DTYPE,\n",
    "        enabled=torch.cuda.is_available()\n",
    "    ):\n",
    "        logits = model(x)\n",
    "    return torch.softmax(logits.float(), dim=-1)\n",
    "\n",
    "\n",
    "def summarize_array(v):\n",
    "    v = np.asarray(v, dtype=float)\n",
    "    return {\n",
    "        \"mean\": float(np.mean(v)),\n",
    "        \"sd\": float(np.std(v, ddof=1)) if len(v) > 1 else 0.0,\n",
    "        \"median\": float(np.median(v)),\n",
    "        \"q25\": float(np.quantile(v, 0.25)),\n",
    "        \"q75\": float(np.quantile(v, 0.75)),\n",
    "    }"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "edb9d223",
   "metadata": {},
   "outputs": [],
   "source": [
    "@torch.no_grad()\n",
    "def evaluate_intervention_run(model, P, V, k, L, source_seed, n_contexts, batch_size):\n",
    "    # Inferential unit later = trained model/source seed, not individual contexts.\n",
    "    sampler_seed = 8_100_000 + 10_000 * k + 100 * L + source_seed\n",
    "    intervention_seed = 9_200_000 + 10_000 * k + 100 * L + source_seed\n",
    "\n",
    "    sampler = PersistentMarkovSampler(\n",
    "        P=P, V=V, k=k, batch_size=batch_size,\n",
    "        max_history=max(L, k),\n",
    "        seed=sampler_seed, warmup_steps=CHAIN_WARMUP\n",
    "    )\n",
    "\n",
    "    gen = torch.Generator(device=DEVICE)\n",
    "    gen.manual_seed(intervention_seed)\n",
    "\n",
    "    critical_rows = []\n",
    "    irrelevant_rows = []\n",
    "\n",
    "    seen = 0\n",
    "    while seen < n_contexts:\n",
    "        b = min(batch_size, n_contexts - seen)\n",
    "\n",
    "        if b == batch_size:\n",
    "            x, _ = sampler.sample(L)\n",
    "        else:\n",
    "            tmp = PersistentMarkovSampler(\n",
    "                P=P, V=V, k=k, batch_size=b,\n",
    "                max_history=max(L, k),\n",
    "                seed=sampler_seed + seen + 17,\n",
    "                warmup_steps=CHAIN_WARMUP\n",
    "            )\n",
    "            x, _ = tmp.sample(L)\n",
    "\n",
    "        p_before = oracle_probs(P, x, V, k)\n",
    "        q_before = model_probs(model, x)\n",
    "\n",
    "        # Critical intervention: oldest token inside the k-token state.\n",
    "        critical_pos = L - k\n",
    "        x_crit = x.clone()\n",
    "        x_crit[:, critical_pos] = make_alternative_tokens(\n",
    "            x[:, critical_pos], V, gen\n",
    "        )\n",
    "\n",
    "        p_crit = oracle_probs(P, x_crit, V, k)\n",
    "        q_crit = model_probs(model, x_crit)\n",
    "\n",
    "        kl_target_before = kl_pq(p_crit, q_before)\n",
    "        kl_target_after = kl_pq(p_crit, q_crit)\n",
    "        tracking_gain = kl_target_before - kl_target_after\n",
    "\n",
    "        critical_rows.append(pd.DataFrame({\n",
    "            \"tracking_gain\": tracking_gain.cpu().numpy(),\n",
    "            \"kl_target_before\": kl_target_before.cpu().numpy(),\n",
    "            \"kl_target_after\": kl_target_after.cpu().numpy(),\n",
    "            \"oracle_shift_js\": js_divergence(p_before, p_crit).cpu().numpy(),\n",
    "            \"model_shift_js\": js_divergence(q_before, q_crit).cpu().numpy(),\n",
    "            \"factual_kl_before\": kl_pq(p_before, q_before).cpu().numpy(),\n",
    "            \"target_oracle_entropy\": entropy(p_crit).cpu().numpy(),\n",
    "        }))\n",
    "\n",
    "        # Irrelevant control: at L=k+1, position 0 is outside the state.\n",
    "        if L > k:\n",
    "            x_irrel = x.clone()\n",
    "            x_irrel[:, 0] = make_alternative_tokens(x[:, 0], V, gen)\n",
    "\n",
    "            p_irrel = oracle_probs(P, x_irrel, V, k)\n",
    "            q_irrel = model_probs(model, x_irrel)\n",
    "\n",
    "            max_oracle_diff = (p_irrel - p_before).abs().max().item()\n",
    "            if max_oracle_diff > 1e-7:\n",
    "                raise AssertionError(\n",
    "                    f\"Irrelevant intervention changed oracle: max diff={max_oracle_diff}\"\n",
    "                )\n",
    "\n",
    "            kl_same_before = kl_pq(p_before, q_before)\n",
    "            kl_same_after = kl_pq(p_before, q_irrel)\n",
    "            tracking_gain_irrel = kl_same_before - kl_same_after\n",
    "\n",
    "            irrelevant_rows.append(pd.DataFrame({\n",
    "                \"tracking_gain\": tracking_gain_irrel.cpu().numpy(),\n",
    "                \"kl_target_before\": kl_same_before.cpu().numpy(),\n",
    "                \"kl_target_after\": kl_same_after.cpu().numpy(),\n",
    "                \"oracle_shift_js\": js_divergence(p_before, p_irrel).cpu().numpy(),\n",
    "                \"model_shift_js\": js_divergence(q_before, q_irrel).cpu().numpy(),\n",
    "                \"factual_kl_before\": kl_same_before.cpu().numpy(),\n",
    "                \"target_oracle_entropy\": entropy(p_before).cpu().numpy(),\n",
    "            }))\n",
    "\n",
    "        seen += b\n",
    "\n",
    "    def aggregate(frames, intervention):\n",
    "        d = pd.concat(frames, ignore_index=True)\n",
    "        row = {\n",
    "            \"intervention\": intervention,\n",
    "            \"n_contexts\": len(d),\n",
    "        }\n",
    "        for col in d.columns:\n",
    "            s = summarize_array(d[col].values)\n",
    "            for stat, val in s.items():\n",
    "                row[f\"{col}_{stat}\"] = val\n",
    "        row[\"positive_tracking_fraction\"] = float((d[\"tracking_gain\"] > 0).mean())\n",
    "        return row\n",
    "\n",
    "    out = [aggregate(critical_rows, \"critical\")]\n",
    "    if irrelevant_rows:\n",
    "        out.append(aggregate(irrelevant_rows, \"irrelevant\"))\n",
    "\n",
    "    return pd.DataFrame(out)"
   ]
  },
