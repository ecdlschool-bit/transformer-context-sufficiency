    "## Seed-level bootstrap summaries\n",
    "\n",
    "The statistical unit is the independent trained source/model seed. Contexts within a run are used only to estimate each run-level effect accurately.\n",
    "\n",
    "For consistency with the manuscript, 95% intervals use 5,000 nonparametric bootstrap resamples over seeds with analysis seed 123. With five Part 1 seeds, these intervals should be interpreted as descriptive summaries of seed-level variation rather than high-precision population uncertainty."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "29356ee9",
   "metadata": {},
   "outputs": [],
   "source": [
    "def bootstrap_mean_ci(values, reps=BOOTSTRAP_REPS, seed=BOOTSTRAP_SEED):\n",
    "    values = np.asarray(values, dtype=float)\n",
    "    values = values[np.isfinite(values)]\n",
    "    if len(values) == 0:\n",
    "        return np.nan, np.nan, np.nan\n",
    "\n",
    "    rng = np.random.default_rng(seed)\n",
    "    idx = rng.integers(0, len(values), size=(reps, len(values)))\n",
    "    boot = values[idx].mean(axis=1)\n",
    "    return (\n",
    "        float(values.mean()),\n",
    "        float(np.quantile(boot, 0.025)),\n",
    "        float(np.quantile(boot, 0.975)),\n",
    "    )\n",
    "\n",
    "\n",
    "summary_rows = []\n",
    "metric_cols = [\n",
    "    \"tracking_gain_mean\",\n",
    "    \"model_shift_js_mean\",\n",
    "    \"oracle_shift_js_mean\",\n",
    "    \"kl_target_before_mean\",\n",
    "    \"kl_target_after_mean\",\n",
    "    \"positive_tracking_fraction\",\n",
    "]\n",
    "\n",
    "for (k, L, intervention), d in raw.groupby([\"k\", \"L\", \"intervention\"]):\n",
    "    row = {\n",
    "        \"k\": int(k),\n",
    "        \"L\": int(L),\n",
    "        \"intervention\": intervention,\n",
    "        \"n_seeds\": int(d[\"seed\"].nunique()),\n",
    "    }\n",
    "    for metric in metric_cols:\n",
    "        mean, lo, hi = bootstrap_mean_ci(d[metric].values)\n",
    "        row[f\"{metric}_mean_over_seeds\"] = mean\n",
    "        row[f\"{metric}_ci95_lo\"] = lo\n",
    "        row[f\"{metric}_ci95_hi\"] = hi\n",
    "    summary_rows.append(row)\n",
    "\n",
    "summary = pd.DataFrame(summary_rows).sort_values([\"k\", \"L\", \"intervention\"])\n",
    "summary_path = CSV_DIR / \"causal_intervention_summary.csv\"\n",
    "summary.to_csv(summary_path, index=False)\n",
    "\n",
    "print(\"Saved:\", summary_path)\n",
    "display(summary)"
   ]
  },
