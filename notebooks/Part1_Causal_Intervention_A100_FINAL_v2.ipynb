  {
   "cell_type": "markdown",
   "id": "a9fde5f6",
   "metadata": {},
   "source": [
    "## Layer-wise activation patching (mechanistic causal test)\n",
    "\n",
    "This stage uses only \\(L=k+1\\), where a state-changing and an irrelevant-token counterfactual can be matched on the **same trained model, source kernel, and factual contexts**.\n",
    "\n",
    "For each encoder layer \\(\\ell\\):\n",
    "\n",
    "1. run the factual and counterfactual inputs through layer \\(\\ell\\);\n",
    "2. replace only the **final-position residual vector** of the factual stream with the corresponding vector from the counterfactual stream;\n",
    "3. continue through the remaining encoder layers and the unchanged native output head;\n",
    "4. measure movement toward the appropriate exact oracle distribution.\n",
    "\n",
    "The critical patch uses activations induced by changing the oldest token in the true Markov state. The negative-control patch uses activations induced by changing only the extra token outside the state. This is an internal intervention; it does not retrain or modify any checkpoint.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "4d61ac71",
   "metadata": {},
   "outputs": [],
   "source": [
    "def _causal_mask(L, device):\n",
    "    return torch.triu(torch.ones((L, L), dtype=torch.bool, device=device), diagonal=1)\n",
    "\n",
    "\n",
    "def _embed_input(model, x):\n",
    "    L = x.shape[1]\n",
    "    pos = torch.arange(L, device=x.device)[None, :]\n",
    "    return model.token_emb(x) + model.pos_emb(pos)\n",
    "\n",
    "\n",
    "def _run_encoder_layer(layer, h, mask):\n",
    "    # TransformerEncoderLayer uses src_mask in supported PyTorch releases.\n",
    "    return layer(h, src_mask=mask)\n",
    "\n",
    "\n",
    "@torch.no_grad()\n",
    "def encoder_states(model, x):\n",
    "    \"\"\"Return residual stream after every encoder layer.\"\"\"\n",
    "    h = _embed_input(model, x)\n",
    "    mask = _causal_mask(x.shape[1], x.device)\n",
    "    states = []\n",
    "    for layer in model.encoder.layers:\n",
    "        h = _run_encoder_layer(layer, h, mask)\n",
    "        states.append(h)\n",
    "    return states, mask\n",
    "\n",
    "\n",
    "@torch.no_grad()\n",
    "def probs_from_patched_state(model, factual_state, donor_state, mask, patch_layer):\n",
    "    \"\"\"Patch final-position residual after patch_layer, then run downstream layers.\"\"\"\n",
    "    h = factual_state.clone()\n",
    "    h[:, -1, :] = donor_state[:, -1, :]\n",
    "    for j in range(patch_layer + 1, len(model.encoder.layers)):\n",
    "        h = _run_encoder_layer(model.encoder.layers[j], h, mask)\n",
    "    logits = model.head(model.norm(h[:, -1, :]))\n",
    "    return torch.softmax(logits.float(), dim=-1)\n",
    "\n",
    "\n",
    "@torch.no_grad()\n",
    "def evaluate_activation_patching_run(model, P, V, k, source_seed, n_contexts, batch_size):\n",
    "    L = k + 1\n",
    "    sampler_seed = 18_100_000 + 10_000 * k + source_seed\n",
    "    intervention_seed = 19_200_000 + 10_000 * k + source_seed\n",
    "\n",
    "    sampler = PersistentMarkovSampler(\n",
    "        P=P, V=V, k=k, batch_size=batch_size,\n",
    "        max_history=L, seed=sampler_seed, warmup_steps=CHAIN_WARMUP\n",
    "    )\n",
    "    gen = torch.Generator(device=DEVICE)\n",
    "    gen.manual_seed(intervention_seed)\n",
    "\n",
    "    rows = []\n",
    "    seen = 0\n",
    "    while seen < n_contexts:\n",
    "        b = min(batch_size, n_contexts - seen)\n",
    "        if b == batch_size:\n",
    "            x, _ = sampler.sample(L)\n",
    "        else:\n",
    "            tmp = PersistentMarkovSampler(\n",
    "                P=P, V=V, k=k, batch_size=b, max_history=L,\n",
    "                seed=sampler_seed + seen + 17, warmup_steps=CHAIN_WARMUP\n",
    "            )\n",
    "            x, _ = tmp.sample(L)\n",
    "\n",
    "        # Counterfactuals on identical factual contexts.\n",
    "        x_crit = x.clone()\n",
    "        critical_pos = L - k  # == 1 when L=k+1\n",
    "        x_crit[:, critical_pos] = make_alternative_tokens(x[:, critical_pos], V, gen)\n",
    "\n",
    "        x_irrel = x.clone()\n",
    "        x_irrel[:, 0] = make_alternative_tokens(x[:, 0], V, gen)\n",
    "\n",
    "        p_fact = oracle_probs(P, x, V, k)\n",
    "        p_crit = oracle_probs(P, x_crit, V, k)\n",
    "        p_irrel = oracle_probs(P, x_irrel, V, k)\n",
    "        if (p_irrel - p_fact).abs().max().item() > 1e-7:\n",
    "            raise AssertionError('Irrelevant activation-patching control changed oracle.')\n",
    "\n",
    "        q_fact = model_probs(model, x)\n",
    "\n",
    "        # Disable autocast here so cached/continued residual streams stay numerically consistent.\n",
    "        fact_states, mask = encoder_states(model, x)\n",
    "        crit_states, _ = encoder_states(model, x_crit)\n",
    "        irrel_states, _ = encoder_states(model, x_irrel)\n",
    "\n",
    "        for layer_idx in range(len(model.encoder.layers)):\n",
    "            q_patch_crit = probs_from_patched_state(\n",
    "                model, fact_states[layer_idx], crit_states[layer_idx], mask, layer_idx\n",
    "            )\n",
    "            q_patch_irrel = probs_from_patched_state(\n",
    "                model, fact_states[layer_idx], irrel_states[layer_idx], mask, layer_idx\n",
    "            )\n",
    "\n",
    "            crit_gain = kl_pq(p_crit, q_fact) - kl_pq(p_crit, q_patch_crit)\n",
    "            irr_gain = kl_pq(p_fact, q_fact) - kl_pq(p_fact, q_patch_irrel)\n",
    "\n",
    "            rows.append(pd.DataFrame({\n",
    "                'layer': layer_idx + 1,\n",
    "                'critical_patch_gain': crit_gain.cpu().numpy(),\n",
    "                'irrelevant_patch_gain': irr_gain.cpu().numpy(),\n",
    "                'critical_patch_model_shift_js': js_divergence(q_fact, q_patch_crit).cpu().numpy(),\n",
    "                'irrelevant_patch_model_shift_js': js_divergence(q_fact, q_patch_irrel).cpu().numpy(),\n",
    "                'oracle_shift_js': js_divergence(p_fact, p_crit).cpu().numpy(),\n",
    "            }))\n",
    "\n",
    "        seen += b\n",
    "\n",
    "    d = pd.concat(rows, ignore_index=True)\n",
    "    out = []\n",
    "    for layer, g in d.groupby('layer'):\n",
    "        row = {'layer': int(layer), 'n_contexts': int(len(g))}\n",
    "        for col in [\n",
    "            'critical_patch_gain', 'irrelevant_patch_gain',\n",
    "            'critical_patch_model_shift_js', 'irrelevant_patch_model_shift_js',\n",
    "            'oracle_shift_js'\n",
    "        ]:\n",
    "            s = summarize_array(g[col].values)\n",
    "            for stat, val in s.items():\n",
    "                row[f'{col}_{stat}'] = val\n",