   "source": [
    "## Paired critical-vs-irrelevant contrast at \\(L=k+1\\)\n",
    "\n",
    "This is the cleanest negative-control comparison because both interventions are applied to the same trained model and source seed. The critical intervention changes the true Markov state; the irrelevant intervention changes only the extra token outside that state."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "592b1904",
   "metadata": {},
   "outputs": [],
   "source": [
    "paired_rows = []\n",
    "\n",
    "for k in KS:\n",
    "    L = k + 1\n",
    "    d = raw[raw[\"k\"].eq(k) & raw[\"L\"].eq(L)]\n",
    "\n",
    "    crit = (\n",
    "        d[d[\"intervention\"].eq(\"critical\")]\n",
    "        .set_index(\"seed\")[\"tracking_gain_mean\"]\n",
    "    )\n",
    "    irr = (\n",
    "        d[d[\"intervention\"].eq(\"irrelevant\")]\n",
    "        .set_index(\"seed\")[\"tracking_gain_mean\"]\n",
    "    )\n",
    "\n",
    "    common = sorted(set(crit.index) & set(irr.index))\n",
    "    diff = np.array([crit.loc[s] - irr.loc[s] for s in common], dtype=float)\n",
    "\n",
    "    mean, lo, hi = bootstrap_mean_ci(diff)\n",
    "    paired_rows.append({\n",
    "        \"k\": k,\n",
    "        \"L\": L,\n",
    "        \"n_seeds\": len(common),\n",
    "        \"critical_minus_irrelevant_tracking_gain\": mean,\n",
    "        \"ci95_lo\": lo,\n",
    "        \"ci95_hi\": hi,\n",
    "        \"all_seed_differences_positive\": bool(np.all(diff > 0)),\n",
    "    })\n",
    "\n",
    "paired = pd.DataFrame(paired_rows)\n",
    "paired_path = CSV_DIR / \"causal_intervention_paired_contrasts.csv\"\n",
    "paired.to_csv(paired_path, index=False)\n",
    "\n",
    "print(\"Saved:\", paired_path)\n",
    "display(paired)"
   ]
