    "## Core definitions\n",
    "\n",
    "These definitions reproduce the Part 1 scratch model and persistent Markov sampler exactly enough to load the saved state dictionaries and kernels. No optimizer or training code is used."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "2fc2913c",
   "metadata": {},
   "outputs": [],
   "source": [
    "def set_seed(seed):\n",
    "    random.seed(seed)\n",
    "    np.random.seed(seed)\n",
    "    torch.manual_seed(seed)\n",
    "    if torch.cuda.is_available():\n",
    "        torch.cuda.manual_seed_all(seed)\n",
    "\n",
    "\n",
    "def context_to_index(context, V):\n",
    "    idx = torch.zeros(context.shape[:-1], dtype=torch.long, device=context.device)\n",
    "    for j in range(context.shape[-1]):\n",
    "        idx = idx * V + context[..., j]\n",
    "    return idx\n",
    "\n",
    "\n",
    "class PersistentMarkovSampler:\n",
    "    def __init__(self, P, V, k, batch_size, max_history, seed, warmup_steps=64):\n",
    "        self.P = P\n",
    "        self.V = V\n",
    "        self.k = k\n",
    "        self.batch_size = batch_size\n",
    "        self.max_history = max(max_history, k)\n",
    "        self.gen = torch.Generator(device=DEVICE)\n",
    "        self.gen.manual_seed(seed + 4_000_003)\n",
    "        self.history = torch.randint(\n",
    "            0, V, (batch_size, self.max_history),\n",
    "            generator=self.gen, device=DEVICE\n",
    "        )\n",
    "        for _ in range(warmup_steps):\n",
    "            self.advance()\n",
    "\n",
    "    @torch.no_grad()\n",
    "    def draw_next(self):\n",
    "        full_k = self.history[:, -self.k:]\n",
    "        idx = context_to_index(full_k, self.V)\n",
    "        probs = self.P[idx]\n",
    "        return torch.multinomial(probs, 1, generator=self.gen).squeeze(1)\n",
    "\n",
    "    @torch.no_grad()\n",
    "    def advance(self):\n",
    "        y = self.draw_next()\n",
    "        self.history = torch.cat([self.history[:, 1:], y[:, None]], dim=1)\n",
    "        return y\n",
    "\n",
    "    @torch.no_grad()\n",
    "    def sample(self, L):\n",
    "        x = self.history[:, -L:].clone()\n",
    "        y = self.draw_next()\n",
    "        self.history = torch.cat([self.history[:, 1:], y[:, None]], dim=1)\n",
    "        return x, y\n",
    "\n",
    "\n",
    "class TinyCausalTransformer(nn.Module):\n",
    "    def __init__(self, V, max_context, d_model=256, n_layers=3, n_heads=8, dim_ff=512):\n",
    "        super().__init__()\n",
    "        self.token_emb = nn.Embedding(V, d_model)\n",
    "        self.pos_emb = nn.Embedding(max_context, d_model)\n",
    "        layer = nn.TransformerEncoderLayer(\n",
    "            d_model=d_model,\n",
    "            nhead=n_heads,\n",
    "            dim_feedforward=dim_ff,\n",
    "            dropout=0.0,\n",
    "            activation=\"gelu\",\n",
    "            batch_first=True,\n",
    "            norm_first=True,\n",
    "        )\n",
    "        self.encoder = nn.TransformerEncoder(layer, num_layers=n_layers)\n",
    "        self.norm = nn.LayerNorm(d_model)\n",
    "        self.head = nn.Linear(d_model, V)\n",
    "        self.max_context = max_context\n",
    "\n",
    "    def forward(self, x):\n",
    "        B, L = x.shape\n",
    "        pos = torch.arange(L, device=x.device)[None, :]\n",
    "        h = self.token_emb(x) + self.pos_emb(pos)\n",
    "        mask = torch.triu(\n",
    "            torch.ones((L, L), dtype=torch.bool, device=x.device),\n",
    "            diagonal=1\n",
    "        )\n",
    "        h = self.encoder(h, mask=mask)\n",
    "        return self.head(self.norm(h[:, -1, :]))"
   ]
  },
